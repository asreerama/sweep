    {
      "id": "maintenance-apfs-snapshots",
      "title": "Thin APFS Snapshots",
      "group": "maintenance",
      "root": "systemLogs",
      "pattern": ".",
      "itemTypes": [
        "directory"
      ],
      "tier": "caution",
      "action": "commandPreview",
      "command": "tmutilThin",
      "undo": "regenerated",
      "rationale": "APFS local snapshots thin via tmutil; removed snapshots can reclaim space."
    },
    {
      "id": "maintenance-dns-flush",
