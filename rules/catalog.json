      ],
      "tier": "safe",
      "action": "commandPreview",
      "command": "dnsFlush",
      "undo": "regenerated",
      "rationale": "DNS cache flush resolves stale cached records without data loss."
    },
    {
      "id": "maintenance-spotlight-reindex",
