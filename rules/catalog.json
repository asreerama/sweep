{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "system-junk-user-caches",
      "title": "User Application Caches",
      "group": "systemJunk",
      "root": "userCaches",
      "pattern": "*",
      "itemTypes": [
        "directory"
      ],
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Application caches in ~/Library/Caches regenerate on next launch. Safe to clean."
    },
    {
      "id": "system-junk-user-logs",
      "title": "User Application Logs",
      "group": "systemJunk",
      "root": "userLogs",
      "pattern": "*",
      "itemTypes": [
        "directory"
      ],
      "minAgeDays": 7,
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "User logs in ~/Library/Logs older than 7 days are safe to remove."
    },
    {
      "id": "system-junk-chrome-cache",
      "title": "Chrome Cache",
      "group": "systemJunk",
      "root": "browserCaches",
      "pattern": "*/Cache",
      "itemTypes": [
        "directory"
      ],
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Chrome browser cache directory regenerates automatically."
    },
    {
      "id": "system-junk-firefox-cache",
      "title": "Firefox Cache",
      "group": "systemJunk",
      "root": "browserCaches",
      "pattern": "*/cache2",
      "itemTypes": [
        "directory"
      ],
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Firefox profile cache2 directory regenerates automatically."
    },
    {
      "id": "system-junk-safari-cache",
      "title": "Safari Cache",
      "group": "systemJunk",
      "root": "browserCaches",
      "pattern": "*/Library/Caches",
      "itemTypes": [
        "directory"
      ],
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Safari container cache directory regenerates automatically."
    },
    {
      "id": "system-junk-crash-reports",
      "title": "Crash Reports",
      "group": "systemJunk",
      "root": "crashReports",
      "pattern": "*.crash",
      "itemTypes": [
        "file"
      ],
      "minAgeDays": 0,
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Crash report files can be safely removed; archived in Apple servers."
    },
    {
      "id": "system-junk-diagnostic-logs",
      "title": "Diagnostic Reports",
      "group": "systemJunk",
      "root": "crashReports",
      "pattern": "*.diag",
      "itemTypes": [
        "file"
      ],
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Diagnostic report files can be safely removed."
    },
    {
      "id": "xcode-derived-data",
      "title": "Xcode Derived Data",
      "group": "systemJunk",
      "root": "xcodeDerivedData",
      "pattern": "*",
      "itemTypes": [
        "directory"
      ],
      "minAgeDays": 0,
      "tier": "safe",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Xcode DerivedData regenerates on build; safe to remove to reclaim space."
    },
    {
      "id": "xcode-archives",
      "title": "Xcode Archives",
      "group": "systemJunk",
      "root": "developerToolCaches",
      "pattern": "Library/Developer/Xcode/Archives/*",
      "itemTypes": [
        "directory"
      ],
      "tier": "caution",
      "action": "trash",
      "undo": "trashRestore",
      "rationale": "Archives may be needed for debugging; marked caution for safety."
    },
    {
      "id": "xcode-device-support",
      "title": "Xcode Device Support",
      "group": "systemJunk",
      "root": "xcodeDeviceSupport",
      "pattern": "*",
      "itemTypes": [
        "directory"
      ],
      "minAgeDays": 0,
      "tier": "caution",
      "action": "trash",
      "undo": "regenerated",
      "rationale": "Symbols repopulate on next device connect, but no unusedness check exists yet; caution until an installed-runtime predicate ships."
    },
    {
      "id": "xcode-simulators",
      "title": "Unavailable iOS Simulators",
      "group": "systemJunk",
      "root": "developerToolCaches",
      "pattern": "CoreSimulator/Devices/*",
      "itemTypes": [
        "directory"
      ],
      "tier": "safe",
      "action": "commandPreview",
      "command": "simctlDeleteUnavailable",
      "undo": "regenerated",
      "rationale": "Obsolete simulator runtimes can be safely removed via xcrun simctl."
    },
    {
      "id": "homebrew-cache",
      "title": "Homebrew Cache",
      "group": "homebrew",
      "root": "homebrewCache",
      "pattern": "*",
      "itemTypes": [
        "directory",
        "file"
      ],
      "tier": "safe",
      "action": "commandPreview",
      "command": "brewCleanup",
      "undo": "regenerated",
      "rationale": "Homebrew downloads cache regenerates on next install; safe to clean via brew cleanup."
    },
